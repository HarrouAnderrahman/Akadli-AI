{
  "name": "@akadli/provider-woocommerce",
  "version": "0.2.0",
  "description": "Stateless WooCommerce store adapter for Akadli-AI Algerian COD voice confirmation",
  "license": "MIT",
  "homepage": "https://akadli.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarrouAnderrahman/Akadli-AI.git",
    "directory": "packages/provider-woocommerce"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ar.md"
  ],
  "keywords": [
    "algeria",
    "dz",
    "cod",
    "akadli",
    "voice-ai",
    "woocommerce",
    "wordpress",
    "ecommerce",
    "adapter"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@akadli/adapter-contract": "workspace:*",
    "@akadli/core": "workspace:*",
    "@akadli/dz-geo": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "msw": "^2.7.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
