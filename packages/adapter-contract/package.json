{
  "name": "@akadli/adapter-contract",
  "version": "0.2.0",
  "description": "Standardized Zod schemas and TypeScript interfaces for Algerian COD voice confirmation and store adapters",
  "license": "MIT",
  "homepage": "https://akadli.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarrouAnderrahman/Akadli-AI.git",
    "directory": "packages/adapter-contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ar.md"
  ],
  "keywords": [
    "algeria",
    "dz",
    "cod",
    "akadli",
    "voice-ai",
    "ecommerce",
    "zod",
    "contracts",
    "schemas"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
