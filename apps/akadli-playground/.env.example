# ElevenLabs API Credentials (Conversational AI Agent with V4 Turbo)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Client Vite dev server port (HTTPS)
PORT=3000

# Backend Express API & WebSocket port
SERVER_PORT=3001

# Optional Call Transcript (STT) & MP3 Audio Archiving
SAVE_CALL_LOGS=true
CALL_LOGS_DIR=./logs/calls

# Shopify Live Store Integration (Optional for local testing / Required for live webhook & mutations)
SHOPIFY_SHOP_DOMAIN=
# Use either direct SHOPIFY_ACCESS_TOKEN or SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2025-01

# YouCan Live Store Integration (Optional for local testing / Required for live webhook & mutations)
YOUCAN_ACCESS_TOKEN=
YOUCAN_WEBHOOK_SECRET=
YOUCAN_API_BASE_URL=https://api.youcan.shop

# WooCommerce Live Store Integration (Optional for local testing / Required for live webhook & mutations)
WOOCOMMERCE_SITE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=

# Google Sheets Algerian COD Integration (Optional for local testing / Required for live webhook & mutations)
# Mode A (Direct Google Sheets REST API v4):
GSHEETS_SPREADSHEET_ID=
GSHEETS_ACCESS_TOKEN=
# Mode B (Google Apps Script Webhook Callback):
GSHEETS_APPS_SCRIPT_URL=
# Webhook Signature Secret (Hex HMAC-SHA256 or shared token in x-akadli-secret):
GSHEETS_WEBHOOK_SECRET=

# Tassyir Algerian COD ERP Integration (Headless OAuth app or direct token; zero-secret Ed25519 webhook verification)
TASSYIR_CLIENT_ID=
TASSYIR_CLIENT_SECRET=
TASSYIR_ACCESS_TOKEN=
TASSYIR_REFRESH_TOKEN=
TASSYIR_API_BASE_URL=https://api.tassyir.io/apps/2026-10

