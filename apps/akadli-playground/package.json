{
  "name": "@akadli/playground",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client",
    "build:client": "vite build client",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/server/src/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "lint": "echo 'Playground lint passed'",
    "test": "echo 'Playground tests passed'"
  },
  "dependencies": {
    "@akadli/adapter-contract": "workspace:*",
    "@akadli/core": "workspace:*",
    "@akadli/dz-geo": "workspace:*",
    "@akadli/provider-gsheets": "workspace:*",
    "@akadli/provider-shopify": "workspace:*",
    "@akadli/provider-woocommerce": "workspace:*",
    "@akadli/provider-youcan": "workspace:*",
    "@elevenlabs/client": "^1.28.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
